# Aethel Fold — build-time configuration for `pnpm build:{mode}`.
# Copy to `.env.{mode}` (git-ignored) and fill the empty values before a
# platform build. Every key/ID is intentionally blank in the repo.
# Platform: CrazyGames

VITE_NODE_ENV=production
VITE_APP_DEBUG=false
VITE_APP_INCLUDE_VCONSOLE=false
VITE_ENABLE_OBFUSCATION=true
VITE_APP_CRAZY_WEB=true
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false
# Ads (roadmaps #9, #17, #19): this platform has an ad SDK, so the placements
# are compiled in. Interstitials on page clear / boss clear / crumple; the
# rewarded Try again and the rewarded second heart. Set false to ship ad-free.
# CrazyGames serves ads only on the full release (VITE_APP_CRAZY_GAMES_FULL_RELEASE=true);
# before that the provider reports nothing ready and the plain UI shows.
VITE_APP_INTERSTITIALS=true
VITE_APP_REWARDED=true
