# Aethel Fold — build-time configuration for `pnpm build:{mode}`.
# Copy to `.env.{mode}` (git-ignored) and fill the empty values before a
# platform build. Every key/ID is intentionally blank in the repo.
# Platform: Poki (SDK v2 from game-cdn.poki.com; saves stay in localStorage)

VITE_NODE_ENV=production
VITE_APP_DEBUG=false
VITE_APP_INCLUDE_VCONSOLE=false
VITE_ENABLE_OBFUSCATION=true
VITE_APP_POKI=true
# Ads (roadmaps #9, #17, #19): Poki has an ad SDK, so the placements are
# compiled in: commercialBreak for the interstitials, rewardedBreak for the
# rewarded Try again and second heart. Poki throttles commercial breaks
# itself; our 3-minute grace and 121 s gap still apply on top.
VITE_APP_INTERSTITIALS=true
VITE_APP_REWARDED=true
