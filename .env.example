# Aethel Fold — build-time configuration for `pnpm build:{mode}`.
# Copy to `.env.{mode}` (git-ignored) and fill the empty values before a
# platform build. Every key/ID is intentionally blank in the repo.
# Platform: plain web (no SDK) — lists every key any mode uses

VITE_NODE_ENV=production
VITE_APP_DEBUG=false
VITE_APP_INCLUDE_VCONSOLE=false
VITE_ENABLE_OBFUSCATION=true
VITE_APP_CRAZY_WEB=false
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false
VITE_APP_GAME_DISTRIBUTION=false
VITE_GAME_DISTRIBUTION_GAME_ID=
VITE_APP_GAME_MONETIZE=false
VITE_GAME_ID=
VITE_APP_GAMEPIX=false
VITE_APP_GLITCH=false
VITE_APP_GLITCH_INSTALL_ID=
VITE_APP_GLITCH_TEST_INSTALL_ID=
VITE_APP_GLITCH_TOKEN=
VITE_APP_ITCH=false
VITE_APP_PLAYGAMA=false
VITE_APP_WAVEDASH=false
VITE_APP_YANDEX=false
